{
  "manifest_version": 3,
  "name": "Jarvis - Sales Copilot",
  "version": "0.1.0",
  "description": "AI-powered sales copilot that orchestrates your day",
  "permissions": ["sidePanel"],
  "host_permissions": ["https://jarvisapi-production-10cd.up.railway.app/*", "http://localhost:4000/*"],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Open Jarvis"
  }
}
